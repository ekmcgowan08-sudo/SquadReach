# SquadRise runs with no environment at all: it boots in DEMO MODE on the
# seeded "Grace Community Students" ministry, with the role switcher on the
# avatar, and keeps everything on this device.
#
# Set both of these to run against your own Supabase project instead. The
# schema is in supabase/migrations — apply it with `supabase db push`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Report emails (optional, Supabase mode) ─────────────────────────────
# The delivery schedule always lands in the app's notifications. Set these
# and it goes out by email too. Server-only: never prefix them NEXT_PUBLIC_.
#
# The service role lets the scheduled job read a ministry with nobody signed
# in. Keep it secret; it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# Resend (resend.com) sends the mail. EMAIL_FROM must be a sender on a domain
# you've verified there, e.g. "Grace Students <reports@gracestudents.org>".
RESEND_API_KEY=
EMAIL_FROM=
# Whatever calls /api/cron/deliveries must send "Authorization: Bearer <this>".
# On Vercel, vercel.json schedules it every 15 minutes and sends it for you.
CRON_SECRET=

# ── Ideas from Claude on the planner (optional) ─────────────────────────
# Leaders can ask Claude to suggest teaching series that fill the plan's
# gaps. Suggestions are checked on the server and never added without a
# leader's tap. Server-only.
ANTHROPIC_API_KEY=
# The demo sends its plan from the browser; set this to 1 to allow that
# (it spends your API credit for anyone who opens the demo).
PLANNER_AI_IN_DEMO=
